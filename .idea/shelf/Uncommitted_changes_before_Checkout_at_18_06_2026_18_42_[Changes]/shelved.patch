     public void setContext(Context context) {
         this.context = context;
+        // SharedPreferences для хранения версии данных
+        if (context != null) {
+            this.prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+        }
+        // Запускаем миграцию после установки контекста
+        if (context != null) {
+            migrateStorage();
+        }
+    }
+
+    private void migrateStorage() {
+        int storedVersion = prefs.getInt(KEY_DATA_VERSION, 0);
+        if (storedVersion >= CURRENT_DATA_VERSION) {
+            return; // миграция не нужна
+        }
+
+        try {
+            // Последовательное выполнение миграций с версии storedVersion до CURRENT_DATA_VERSION
+            for (int version = storedVersion + 1; version <= CURRENT_DATA_VERSION; version++) {
+                applyMigration(version);
+            }
+            // Сохраняем новую версию
+            prefs.edit().putInt(KEY_DATA_VERSION, CURRENT_DATA_VERSION).apply();
+        } catch (Exception e) {
+            // Логирование ошибки – в реальном приложении нужно предусмотреть стратегию восстановления
+            e.printStackTrace();
+        }
+    }
+
+    private void applyMigration(int targetVersion) throws Exception {
+        switch (targetVersion) {
+            case 1:
+                migrateToVersion1();
+                break;
+            default:
+                throw new UnsupportedOperationException("Unknown migration version: " + targetVersion);
+        }
+    }
+
+    private void migrateToVersion1() throws IOException {
+        File baseDir = getStorageBaseDir();
+        File legacyRoot = context.getFilesDir();  // старая корневая папка (без APP_DIR_NAME)
+
+        // === 1. Создаём папки, если их нет ===
+        if (!baseDir.exists()) {
+            baseDir.mkdirs();
+        }
+        File usersDir = new File(baseDir, USERS_DIR);
+        if (!usersDir.exists()) {
+            usersDir.mkdirs();
+        }
+
+        // === 2. Перенос данных из старого корня (context.getFilesDir()), если они там есть ===
+        // Это актуально, если раньше приложение писало всё напрямую в getFilesDir().
+        if (legacyRoot != null && legacyRoot.exists()) {
+            File[] legacyFiles = legacyRoot.listFiles();
+            if (legacyFiles != null) {
+                for (File file : legacyFiles) {
+                    // Игнорируем служебные файлы и саму новую базовую папку
+                    if (file.getName().equals(APP_DIR_NAME) || file.getName().startsWith(".")
+                            || file.getName().equals("profile_installer") || file.getName().equals("lib")) {
+                        continue;
+                    }
+                    // Перемещаем только папки пользователей и файлы алгоритмов
+                    if (file.isDirectory() && !file.getName().equals(USERS_DIR)) {
+                        // Похоже на папку пользователя – переносим в users/
+                        File dest = new File(usersDir, file.getName());
+                        if (!dest.exists()) {
+                            moveFileOrDir(file, dest);
+                        }
+                    } else if (file.isFile() && (file.getName().startsWith("algorithm") || file.getName().endsWith(".txt"))) {
+                        // Файл алгоритма – переносим в базовую директорию
+                        File dest = new File(baseDir, file.getName());
+                        if (!dest.exists()) {
+                            moveFileOrDir(file, dest);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private void moveFileOrDir(File source, File dest) throws IOException {
+        if (source.isDirectory()) {
+            if (!dest.exists()) {
+                dest.mkdirs();
+            }
+            File[] children = source.listFiles();
+            if (children != null) {
+                for (File child : children) {
+                    moveFileOrDir(child, new File(dest, child.getName()));
+                }
+            }
+            source.delete(); // удаляем исходную папку после перемещения
+        } else {
+            // Копируем и удаляем оригинал
+            try (InputStream in = new FileInputStream(source);
+                 OutputStream out = new FileOutputStream(dest)) {
+                byte[] buffer = new byte[4096];
+                int length;
+                while ((length = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, length);
+                }
+            }
+            source.delete();
+        }
     }
 

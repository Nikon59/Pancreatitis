<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp"/>  <!-- Скругленные углы -->
    <solid android:color="@android:color/white"/> <!-- Цвет фона -->
    <padding
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp"/>

    <stroke
        android:width="1dp"
        android:color="@color/colorCircle"/> <!-- Цвет рамки -->
</shape>

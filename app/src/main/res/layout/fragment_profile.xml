<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок профиля -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#3F51B5"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Личный кабинет"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/title_fio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Иванов Иван Иванович"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Карточка с информацией -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <!-- ФИО -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ФИО"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/fioValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Иванов Иван Иванович"
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F8F8F8"
                android:layout_marginBottom="16dp" />

            <!-- Электронная почта -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Электронная почта"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/emailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ivanov@example.com"
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F8F8F8"
                android:layout_marginBottom="16dp" />

            <!-- Номер телефона -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Номер телефона"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/phoneValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+7 (999) 123-45-67"
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F8F8F8"
                android:layout_marginBottom="16dp" />

            <!-- Логин -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Логин"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/loginValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ivanov_ii"
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F8F8F8"
                android:layout_marginBottom="16dp" />

            <!-- Пароль -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Пароль"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/passwordValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="••••••••"
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F8F8F8"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

        <!-- Кнопка выхода -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="@drawable/rounded_background"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.pancreatitis.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_questionnaire"
            app:destination="@id/navigation_questionnaires" />
    </fragment>

    <fragment
        android:id="@+id/navigation_helps"
        android:name="com.pancreatitis.ui.helps.HelpsFragment"
        android:label="@string/title_helps"
        tools:layout="@layout/fragment_helps" />

    <fragment
        android:id="@+id/navigation_activate"
        android:name="com.pancreatitis.ui.activate.ActivateFragment"
        android:label="@string/title_activate"
        tools:layout="@layout/fragment_activate" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.pancreatitis.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" >

        <action
            android:id="@+id/action_profile_to_auth"
            app:destination="@id/navigation_auth"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_questionnaires"
        android:name="com.pancreatitis.ui.questionnaires.AllQuestionnaireFragment"
        android:label="@string/title_questionnaires"
        tools:layout="@layout/fragment_questionnaires">

        <action
            android:id="@+id/action_questionnaires_to_anket"
            app:destination="@id/navigation_anket" />
    </fragment>

    <fragment
        android:id="@+id/navigation_anket"
        android:name="com.pancreatitis.ui.questionnaire.PatientInformationFragment"
        android:label="@string/title_predict"
        tools:layout="@layout/fragment_questionnaire" >

        <action
            android:id="@+id/action_anket_to_characteristic"
            app:destination="@id/navigation_characteristic" />
    </fragment>

    <fragment
        android:id="@+id/navigation_auth"
        android:name="com.pancreatitis.ui.auth.AuthFragment"
        android:label="@string/title_auth"
        tools:layout="@layout/fragment_auth" >

        <action
            android:id="@+id/action_auth_to_register"
            app:destination="@id/navigation_register" />

        <action
            android:id="@+id/action_auth_to_profile"
            app:destination="@id/navigation_profile" />

        <action
            android:id="@+id/action_auth_to_activate"
            app:destination="@id/navigation_activate" />
    </fragment>

    <fragment
        android:id="@+id/navigation_register"
        android:name="com.pancreatitis.ui.register.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/navigation_characteristic"
        android:name="com.pancreatitis.ui.characteristic.CharacteristicFragment"
        android:label="@string/title_characteristic"
        tools:layout="@layout/fragment_characteristic" >

        <action
            android:id="@+id/action_characteristic_to_ankter"
            app:destination="@id/navigation_anket" />
    </fragment>
</navigation>